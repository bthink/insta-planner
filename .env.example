# Runtime data must be outside this repository. ~ is expanded on the server.
INSTAPLANNER_DATA_DIR=~/Pictures/InstaPlanner-data
# Optional. Never commit .env.local or include it in a data backup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# FFmpeg is optional; failed thumbnails never block import.
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
